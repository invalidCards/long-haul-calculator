{
  "name": "long-haul-calculator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test src/**/*.test.js",
    "data:trainkms": "node scripts/generate-trainkms-snapshot.mjs",
